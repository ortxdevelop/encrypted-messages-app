# Database Configuration
# Leave these as default for Docker setup
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/secure_app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Secret Key
# IMPORTANT: Generate a secure random string (minimum 32 characters)
# How to generate:
#   - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   - Bash/Linux: openssl rand -base64 32
#   - Online: https://www.random.org/strings/ (32+ characters)
JWT_SECRET=<your-secret-key-min-32-characters-long-for-hs256-algorithm>

# Encryption Key for AES-256-GCM
# IMPORTANT: Generate a base64-encoded 32-byte key
# How to generate:
#   - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   - Bash/Linux: openssl rand -base64 32
#   - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<your-base64-encoded-32-byte-encryption-key-here>

# Example of valid keys (DO NOT USE THESE IN PRODUCTION):
# JWT_SECRET=mIXcqnYtqtWnSKxtasTF28V8sQ1AinMSSBt5
# ENCRYPTION_KEY=kGF42VpWKJ+CIiNn7EhoAqqjgHIzNe+CKoHpd4RIZvQ=
